{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DXN Questions Schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "question", "answer"],
    "properties": {
      "id": { "type": "string" },
      "question": { "type": "string" },
      "answer": { "type": "string" },
      "keywords": {
        "type": "array",
        "items": { "type": "string" }
      },
      "whatsapp": { "type": "boolean" },
      "tags": { "type": "array", "items": { "type": "string" } },
      "locale": { "type": "string" },
      "source": { "type": "string" },
      "row": { "type": "integer" }
    }
  }
}
